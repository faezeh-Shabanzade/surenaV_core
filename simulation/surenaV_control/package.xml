<?xml version="1.0"?>
<package format="2">
  <name>surenaV_control</name>
  <version>1.0.0</version>
  <description>
    Position and velocity control for the Surena V humanoid: ros_control
    controller configurations, Gazebo Classic integration, a standalone
    PyBullet control interface, and a hardware-interface template for the
    physical actuators.
  </description>

  <maintainer email="cast@ut.ac.ir">CAST / Surena V maintainers</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>surenaV_description</exec_depend>
  <exec_depend>surenaV_gazebo</exec_depend>

  <export>
  </export>
</package>
